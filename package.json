{
  "name": "angebotspilot-native",
  "version": "0.1.0",
  "private": true,
  "description": "Native iOS shell for AngebotsPilot",
  "scripts": {
    "prepare:web": "node scripts/prepare-web.mjs",
    "prepare:ios": "node scripts/patch-ios.mjs",
    "ios:fresh": "rm -rf ios && npx cap add ios && npx cap sync ios && node scripts/patch-ios.mjs",
    "ios:sync": "npx cap sync ios && node scripts/patch-ios.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.0.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/core": "8.5.1",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "8.5.1",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.1"
  },
  "engines": {
    "node": ">=22"
  }
}
