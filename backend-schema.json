{
  "schemaVersion": 6,
  "idStrategy": "text; neue IDs bevorzugen crypto.randomUUID(), bestehende Test-IDs bleiben kompatibel",
  "tables": {
    "companies": {
      "primaryKey": "id",
      "from": "data.meta.companyId + data.settings"
    },
    "users": {
      "primaryKey": "id",
      "foreignKeys": {
        "companyId": "companies.id"
      },
      "roles": [
        "owner",
        "office",
        "worker"
      ]
    },
    "customers": {
      "primaryKey": "id",
      "foreignKeys": {
        "companyId": "companies.id"
      }
    },
    "offers": {
      "primaryKey": "id",
      "foreignKeys": {
        "companyId": "companies.id",
        "customerId": "customers.id"
      }
    },
    "events": {
      "primaryKey": "id",
      "foreignKeys": {
        "companyId": "companies.id",
        "customerId": "customers.id",
        "offerId": "offers.id",
        "jobId": "jobs.id"
      }
    },
    "tasks": {
      "primaryKey": "id",
      "foreignKeys": {
        "companyId": "companies.id"
      }
    },
    "jobs": {
      "primaryKey": "id",
      "foreignKeys": {
        "companyId": "companies.id",
        "customerId": "customers.id",
        "offerId": "offers.id",
        "invoiceId": "invoices.id"
      }
    },
    "invoices": {
      "primaryKey": "id",
      "foreignKeys": {
        "companyId": "companies.id",
        "customerId": "customers.id",
        "offerId": "offers.id",
        "jobId": "jobs.id"
      }
    },
    "catalog": {
      "primaryKey": "id",
      "foreignKeys": {
        "companyId": "companies.id"
      }
    },
    "customer_files": {
      "primaryKey": "id",
      "foreignKeys": {
        "companyId": "companies.id",
        "customerId": "customers.id"
      },
      "binaryStorage": "object storage / bucket later"
    }
  },
  "commonEntityFields": [
    "id",
    "companyId",
    "createdBy",
    "createdAt",
    "updatedAt",
    "syncState"
  ]
}